        // Open Detail Modal
        function openDetailModal(id) {
            const item = destinationDatabase.find(d => d.id === id);
            if (!item) return;

            document.getElementById('modalHeader').style.backgroundImage = `url('${item.image}')`;
            document.getElementById('modalTitle').innerText = item.name;
            document.getElementById('modalSubtitle').innerText = `${item.tagline} • 추천 여행적기: ${item.bestSeason}`;
            
            document.getElementById('modalVibes').innerHTML = item.vibes.map(v => 
                `<span class="bg-indigo-600/80 backdrop-blur-md text-white text-[10px] font-semibold px-2.5 py-0.5 rounded-md">#${v}</span>`
            ).join('');

            const itinContainer = document.getElementById('itineraryDays');
            itinContainer.innerHTML = item.itinerary.map(day => `
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-1">
                    <span class="text-[11px] font-bold text-indigo-400 uppercase tracking-wider">DAY ${day.day} - ${day.title}</span>
                    <p class="text-xs text-slate-200">${day.desc}</p>
                </div>
            `).join('');

            document.getElementById('costFlight').innerText = item.cost.flight;
            document.getElementById('costHotel').innerText = item.cost.hotel;
            document.getElementById('costFood').innerText = item.cost.food;
            document.getElementById('costTotal').innerText = item.cost.total;

            document.getElementById('foodList').innerHTML = item.foods.map(f => `<li>${f}</li>`).join('');
            document.getElementById('checklistItems').innerHTML = item.checklist.map(c => `
                <li class="flex items-center gap-2">
                    <i class="fa-regular fa-square-check text-emerald-400"></i>
                    <span>${c}</span>
                </li>
            `).join('');

            switchModalTab('itinerary');
            document.getElementById('detailModal').classList.remove('hidden');
        }

        // Modal Tab Switcher
        function switchModalTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tabContentItinerary').classList.add('hidden');
            document.getElementById('tabContentCost').classList.add('hidden');
            document.getElementById('tabContentPrep').classList.add('hidden');

            if (tab === 'itinerary') {
                document.getElementById('tabItinerary').classList.add('active');
                document.getElementById('tabContentItinerary').classList.remove('hidden');
            } else if (tab === 'cost') {
                document.getElementById('tabCost').classList.add('active');
                document.getElementById('tabContentCost').classList.remove('hidden');
            } else if (tab === 'prep') {
                document.getElementById('tabPrep').classList.add('active');
                document.getElementById('tabContentPrep').classList.remove('hidden');
            }
        }

