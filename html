        // Vibe Selector Toggle Handler
        function toggleVibe(vibe, el) {
            if (currentVibes.includes(vibe)) {
                currentVibes = currentVibes.filter(v => v !== vibe);
                el.classList.remove('border-indigo-500/50', 'bg-indigo-600/20', 'text-indigo-300');
                el.classList.add('border-slate-700', 'bg-slate-900/60', 'text-slate-300');
            } else {
                currentVibes.push(vibe);
                el.classList.remove('border-slate-700', 'bg-slate-900/60', 'text-slate-300');
                el.classList.add('border-indigo-500/50', 'bg-indigo-600/20', 'text-indigo-300');
