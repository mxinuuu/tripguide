        // Real-time Dynamic Filtering & Search Engine
        function renderDestinations() {
            const container = document.getElementById('destinationsList');
            container.innerHTML = '';

            const keywordInput = document.getElementById('customKeywords').value.trim().toLowerCase();
            const selectedDuration = document.getElementById('durationSelect').value;

            let filtered = destinationDatabase.filter(item => {
                // Category Filter (국내, 아시아, 유럽, 미주, 기타)
                if (currentCategoryFilter !== 'all' && item.region !== currentCategoryFilter) {
                    return false;
                }

                // Duration Filter
                if (selectedDuration !== 'all' && item.duration !== selectedDuration) {
                    return false;
                }

                // Vibe Filter (Any match if selected)
                if (currentVibes.length > 0) {
                    const hasVibe = item.vibes.some(v => currentVibes.includes(v));
                    if (!hasVibe) return false;
                }

                // Keyword Search Match (In name, tagline, why, keywords array, or spots)
                if (keywordInput !== '') {
                    const searchTarget = (
                        item.name + " " +
                        item.tagline + " " +
                        item.why + " " +
                        item.keywords.join(" ") + " " +
                        item.spots.map(s => s.name + " " + s.desc).join(" ")
                    ).toLowerCase();

                    if (!searchTarget.includes(keywordInput)) {
                        return false;
                    }
                }

                return true;
            });

            document.getElementById('resultBadge').innerText = `${filtered.length}개 검색됨`;

