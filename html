                            <button onclick="toggleSave('${item.id}')" class="absolute top-3 right-3 w-9 h-9 bg-slate-950/80 backdrop-blur-md rounded-full flex items-center justify-center text-slate-300 hover:text-amber-400 transition-colors border border-slate-700">
