            const index = savedDestinations.findIndex(s => s.id === id);
            if (index > -1) {
                savedDestinations.splice(index, 1);
            } else {
                const item = destinationDatabase.find(d => d.id === id);
                if (item) savedDestinations.push(item);
            }
            localStorage.setItem('tripGuide_saved', JSON.stringify(savedDestinations));
            updateSavedBadge();
            renderDestinations();
        }

        function updateSavedBadge() {
            const badge = document.getElementById('savedCountBadge');
            if (savedDestinations.length > 0) {
                badge.innerText = savedDestinations.length;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        // Saved Wishlist Modal Handler
        function openSavedModal() {
            const container = document.getElementById('savedListContainer');
            container.innerHTML = '';

            if (savedDestinations.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-500 text-center py-8">아직 저장한 위시리스트 여행지가 없습니다.</p>`;
            } else {
                savedDestinations.forEach(item => {
                    container.innerHTML += `
                        <div class="flex items-center justify-between bg-slate-950 p-3 rounded-xl border border-slate-800">
                            <div class="flex items-center gap-3">
                                <img src="${item.image}" class="w-12 h-12 rounded-lg object-cover">
                                <div>
                                    <h4 class="text-xs font-bold text-white">${item.name}</h4>
                                    <span class="text-[10px] text-slate-400">${item.cost.total}</span>
                                </div>
                            </div>
                            <button onclick="toggleSave('${item.id}'); openSavedModal();" class="text-slate-400 hover:text-rose-400 text-xs px-2 py-1">
                                <i class="fa-solid fa-trash-can"></i> 삭제
                            </button>
                        </div>
                    `;
                });
            }
            document.getElementById('savedModal').classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        // AI Form Handler Simulation
        function handleFormSubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('submitBtn');
            const originalText = btn.innerHTML;
            
            btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> 맞춤 매칭 알고리즘 검색 중...`;
            btn.disabled = true;

            setTimeout(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
                renderDestinations();
            }, 250);
        }
    </script>
</body>
</html>
