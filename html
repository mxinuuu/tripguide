<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TripGuide AI Pro - 글로벌 초맞춤 여행 가이드 & 일정 플래너</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Pretendard', sans-serif; }
        .glass-panel {
            background: rgba(30, 41, 59, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.4);
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(99, 102, 241, 0.7);
        }
        .tab-btn.active {
            border-bottom: 2px solid #818cf8;
            color: #818cf8;
            font-weight: 600;
        }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col custom-scrollbar">

    <header class="border-b border-slate-800 bg-slate-950/90 sticky top-0 z-50 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center text-white text-xl font-extrabold shadow-lg shadow-indigo-500/20">
                    <i class="fa-solid fa-compass"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-black tracking-tight bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">TripGuide AI Pro</h1>
                        <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">v4.0 Global</span>
                    </div>
                    <p class="text-[11px] text-slate-400">전 세계 45개+ 글로벌 추천 여행지 빅데이터 매칭</p>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <button onclick="openSavedModal()" class="relative flex items-center gap-2 text-xs bg-slate-900 hover:bg-slate-800 text-slate-300 px-3.5 py-2 rounded-xl border border-slate-800 transition-all">
                    <i class="fa-solid fa-bookmark text-amber-400"></i>
                    <span>위시리스트</span>
                    <span id="savedCountBadge" class="bg-indigo-600 text-white text-[10px] font-bold px-1.5 py-0.2 rounded-full hidden">0</span>
                </button>
                <div class="hidden md:flex items-center gap-2 text-xs text-slate-400 bg-slate-900/80 px-3 py-1.5 rounded-full border border-slate-800">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                    <span id="dbCounterText">45개 데이터베이스 준비됨</span>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- Sidebar / Filter Panel -->
        <aside class="lg:col-span-4 space-y-6">
            <div class="glass-panel rounded-2xl p-6 shadow-2xl relative overflow-hidden">
                <div class="absolute -top-10 -right-10 w-32 h-32 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="flex items-center justify-between mb-5">
                    <h2 class="text-base font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-indigo-400"></i> AI 초맞춤 실시간 필터
                    </h2>
                    <button onclick="resetFilters()" class="text-xs text-slate-400 hover:text-indigo-400 transition-colors flex items-center gap-1">
                        <i class="fa-solid fa-rotate-left"></i> 초기화
                    </button>
                </div>

                <form id="recommendForm" onsubmit="handleFormSubmit(event)" class="space-y-5">
                    
                    <!-- Search Input -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-2">🔍 여행지 / 검색 키워드</label>
                        <div class="relative">
                            <input type="text" id="customKeywords" onkeyup="handleKeyupSearch()" placeholder="예: 야경, 온천, 온구, 오로라, 사막, 리조트, 스노클링, 가성비, 유럽, 미국" class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-9 pr-3.5 py-2.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-500 text-xs"></i>
                        </div>
                        <!-- Quick Keyword Tags -->
                        <div class="flex flex-wrap gap-1.5 mt-2.5">
                            <button type="button" onclick="setKeyword('온천')" class="text-[10px] bg-slate-900 hover:bg-indigo-900/40 text-slate-300 border border-slate-800 px-2 py-0.5 rounded-md">#온천</button>
                            <button type="button" onclick="setKeyword('야경')" class="text-[10px] bg-slate-900 hover:bg-indigo-900/40 text-slate-300 border border-slate-800 px-2 py-0.5 rounded-md">#야경</button>
                            <button type="button" onclick="setKeyword('오로라')" class="text-[10px] bg-slate-900 hover:bg-indigo-900/40 text-slate-300 border border-slate-800 px-2 py-0.5 rounded-md">#오로라</button>
                            <button type="button" onclick="setKeyword('사막')" class="text-[10px] bg-slate-900 hover:bg-indigo-900/40 text-slate-300 border border-slate-800 px-2 py-0.5 rounded-md">#사막</button>
                            <button type="button" onclick="setKeyword('스노클링')" class="text-[10px] bg-slate-900 hover:bg-indigo-900/40 text-slate-300 border border-slate-800 px-2 py-0.5 rounded-md">#스노클링</button>
                            <button type="button" onclick="setKeyword('신혼여행')" class="text-[10px] bg-slate-900 hover:bg-indigo-900/40 text-slate-300 border border-slate-800 px-2 py-0.5 rounded-md">#신혼여행</button>
                            <button type="button" onclick="setKeyword('가성비')" class="text-[10px] bg-slate-900 hover:bg-indigo-900/40 text-slate-300 border border-slate-800 px-2 py-0.5 rounded-md">#가성비</button>
                        </div>
                    </div>

                    <!-- 1. Companion Type -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-2">1. 동행 형태</label>
                        <div class="grid grid-cols-2 gap-2" id="companionContainer">
                            <button type="button" onclick="selectCompanion('all', this)" class="companion-btn border border-indigo-500/50 bg-indigo-600/20 text-indigo-300 px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                                🌐 전체 보기
                            </button>
                            <button type="button" onclick="selectCompanion('solo', this)" class="companion-btn border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-slate-300 px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                                🧍 혼자 (솔로)
                            </button>
                            <button type="button" onclick="selectCompanion('couple', this)" class="companion-btn border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-slate-300 px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                                💑 연인/커플
                            </button>
                            <button type="button" onclick="selectCompanion('family', this)" class="companion-btn border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-slate-300 px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                                👨‍👩‍👧‍👦 가족/부모님
                            </button>
                        </div>
                    </div>

                    <!-- 2. Vibe/Theme Selection -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-2">2. 여행 테마 (다중 선택)</label>
                        <div class="grid grid-cols-2 gap-2" id="vibeContainer">
                            <button type="button" onclick="toggleVibe('Culture', this)" class="vibe-btn border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-slate-300 px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                                🏛️ 문화/역사
                            </button>
                            <button type="button" onclick="toggleVibe('Nature', this)" class="vibe-btn border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-slate-300 px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                                🌲 자연/힐링
                            </button>
                            <button type="button" onclick="toggleVibe('City', this)" class="vibe-btn border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-slate-300 px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                                🏙️ 도시/쇼핑
                            </button>
                            <button type="button" onclick="toggleVibe('Food', this)" class="vibe-btn border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-slate-300 px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                                🍕 미식/맛집
                            </button>
                            <button type="button" onclick="toggleVibe('Resort', this)" class="vibe-btn border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-slate-300 px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                                🏝️ 휴양/휴식
                            </button>
                            <button type="button" onclick="toggleVibe('Activity', this)" class="vibe-btn border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-slate-300 px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition-all">
                                🏄 액티비티
                            </button>
                        </div>
                    </div>

                    <!-- 3. Duration Selection -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-2">3. 예상 일정 범위</label>
                        <select id="durationSelect" onchange="renderDestinations()" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500 transition-colors">
                            <option value="all">전체 일정 범위</option>
                            <option value="short">당일 ~ 2박 3일 (국내 및 근교)</option>
                            <option value="medium">3박 ~ 5박 (아시아 / 근거리)</option>
                            <option value="long">1주일 이상 (유럽, 미주, 대양주 등)</option>
                        </select>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" id="submitBtn" class="w-full py-3.5 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 hover:from-indigo-600 hover:via-purple-600 hover:to-pink-600 text-white font-bold rounded-xl text-xs sm:text-sm shadow-xl shadow-indigo-500/20 transition-all flex items-center justify-center gap-2 transform active:scale-95">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> AI 실시간 매칭 검색 실행
                    </button>
                </form>
            </div>
        </aside>

        <section class="lg:col-span-8 space-y-6">
            
            <!-- Filter Bar & Region Categories Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 glass-panel p-4 rounded-2xl">
                <div>
                    <h2 class="text-lg font-bold text-white flex items-center gap-2">
                        <span>추천 목적지 탐색</span>
                        <span id="resultBadge" class="bg-indigo-500/20 text-indigo-300 text-xs font-semibold px-2.5 py-0.5 rounded-full border border-indigo-500/30">0개 검색됨</span>
                    </h2>
                    <p class="text-xs text-slate-400 mt-0.5">대륙별 및 맞춤 키워드 조건에 일치하는 결과입니다.</p>
                </div>
                
                <div class="flex items-center gap-1.5 self-start sm:self-auto flex-wrap">
                    <button onclick="filterCategory('all')" class="cat-filter-btn px-2.5 py-1.5 rounded-lg text-xs font-medium bg-indigo-600 text-white transition-colors">전체</button>
                    <button onclick="filterCategory('korea')" class="cat-filter-btn px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 transition-colors">국내</button>
                    <button onclick="filterCategory('asia')" class="cat-filter-btn px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 transition-colors">아시아</button>
                    <button onclick="filterCategory('europe')" class="cat-filter-btn px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 transition-colors">유럽</button>
                    <button onclick="filterCategory('americas')" class="cat-filter-btn px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 transition-colors">미주/대양주</button>
                    <button onclick="filterCategory('others')" class="cat-filter-btn px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 transition-colors">중동/기타</button>
                </div>
            </div>

            <!-- Destinations Cards Container -->
            <div id="destinationsList" class="space-y-6">
                <!-- Dynamically Rendered Cards -->
            </div>
        </section>
    </main>

    <!-- Detailed Destination Modal -->
    <div id="detailModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-700/80 w-full max-w-4xl max-h-[90vh] rounded-2xl overflow-hidden flex flex-col shadow-2xl">
            <div id="modalHeader" class="relative h-48 sm:h-64 bg-slate-800 flex items-end p-6 bg-cover bg-center">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/50 to-transparent"></div>
                <button onclick="closeModal('detailModal')" class="absolute top-4 right-4 w-9 h-9 bg-slate-900/80 text-slate-300 hover:text-white rounded-full flex items-center justify-center backdrop-blur-md border border-slate-700 transition-all">
                    <i class="fa-solid fa-xmark"></i>
                </button>
                <div class="relative z-10 w-full">
                    <div id="modalVibes" class="flex flex-wrap gap-1.5 mb-2"></div>
                    <h3 id="modalTitle" class="text-2xl sm:text-3xl font-black text-white"></h3>
                    <p id="modalSubtitle" class="text-xs sm:text-sm text-slate-300 mt-1"></p>
                </div>
            </div>

            <!-- Modal Tabs -->
            <div class="flex border-b border-slate-800 bg-slate-950 px-6 text-xs text-slate-400 gap-6">
                <button onclick="switchModalTab('itinerary')" id="tabItinerary" class="tab-btn py-3 active flex items-center gap-1.5">
                    <i class="fa-solid fa-calendar-days"></i> 추천 일정표
                </button>
                <button onclick="switchModalTab('cost')" id="tabCost" class="tab-btn py-3 flex items-center gap-1.5">
                    <i class="fa-solid fa-calculator"></i> 예상 비용 상세
                </button>
                <button onclick="switchModalTab('prep')" id="tabPrep" class="tab-btn py-3 flex items-center gap-1.5">
                    <i class="fa-solid fa-clipboard-check"></i> 대표 음식 & 팁
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 overflow-y-auto custom-scrollbar flex-1 space-y-6 text-slate-300 text-xs leading-relaxed">
                <div id="tabContentItinerary" class="space-y-4">
                    <p class="text-slate-400">현지 추천 필수 핵심 동선 코스입니다.</p>
                    <div id="itineraryDays" class="space-y-4"></div>
                </div>

                <div id="tabContentCost" class="hidden space-y-4">
                    <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                        <h4 class="font-bold text-white mb-2 text-sm">예상 1인 비용 산출 내역</h4>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center mb-4">
                            <div class="bg-slate-900 p-3 rounded-lg border border-slate-800">
                                <span class="text-slate-400 block text-[10px]">✈️ 왕복 항공/교통</span>
                                <span id="costFlight" class="text-indigo-400 font-bold sm:text-sm">0원</span>
                            </div>
                            <div class="bg-slate-900 p-3 rounded-lg border border-slate-800">
                                <span class="text-slate-400 block text-[10px]">🏨 평균 숙박비</span>
                                <span id="costHotel" class="text-indigo-400 font-bold sm:text-sm">0원</span>
                            </div>
                            <div class="bg-slate-900 p-3 rounded-lg border border-slate-800">
                                <span class="text-slate-400 block text-[10px]">🍜 일일 예상 식비</span>
                                <span id="costFood" class="text-indigo-400 font-bold sm:text-sm">0원</span>
                            </div>
                            <div class="bg-indigo-950/40 p-3 rounded-lg border border-indigo-800/50">
                                <span class="text-indigo-300 block text-[10px] font-semibold">💰 총 예상비용</span>
                                <span id="costTotal" class="text-pink-400 font-extrabold sm:text-sm">0원</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="tabContentPrep" class="hidden space-y-4">
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                            <h4 class="font-bold text-amber-400 mb-2 flex items-center gap-1.5 text-xs">
                                <i class="fa-solid fa-utensils"></i> 필수 대표 먹거리
                            </h4>
                            <ul id="foodList" class="list-disc list-inside space-y-1 text-slate-300"></ul>
                        </div>
                        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                            <h4 class="font-bold text-emerald-400 mb-2 flex items-center gap-1.5 text-xs">
                                <i class="fa-solid fa-passport"></i> 여행 체크리스트
                            </h4>
                            <ul id="checklistItems" class="space-y-1 text-slate-300"></ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-t border-slate-800 p-4 bg-slate-950 flex justify-between items-center">
                <span class="text-[11px] text-slate-500">TripGuide AI Global Engine • 최신 매칭 시스템</span>
                <button onclick="closeModal('detailModal')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-xs transition-colors">닫기</button>
            </div>
        </div>
    </div>

    <!-- Saved Wishlist Modal -->
    <div id="savedModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-800 w-full max-w-2xl rounded-2xl p-6 space-y-4 shadow-2xl">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-bookmark text-amber-400"></i> 저장한 여행지 (위시리스트)
                </h3>
                <button onclick="closeModal('savedModal')" class="text-slate-400 hover:text-white">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div id="savedListContainer" class="space-y-3 max-h-96 overflow-y-auto custom-scrollbar"></div>
            <div class="flex justify-end pt-2">
                <button onclick="closeModal('savedModal')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-xs transition-colors">닫기</button>
            </div>
        </div>
    </div>

    <footer class="border-t border-slate-800/80 bg-slate-950 py-6 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500 space-y-1">
            <p>© 2026 TripGuide AI Pro Global. All rights reserved. | 초맞춤 빅데이터 실시간 여행 알고리즘</p>
        </div>
    </footer>

    <script>
        // Massive Database containing 45 global destinations with fine-grained tags & keywords
        const destinationDatabase = [
            // --- Asia / 근거리 ---
            {
                id: 'kyoto',
                region: 'asia',
                duration: 'medium',
                name: '교토 (Kyoto), 일본',
                tagline: '천년의 역사가 숨쉬는 고요한 전통과 문화의 도시',
                vibes: ['Culture', 'Nature'],
                keywords: ['교토', '일본', '문화', '역사', '절', '신사', '단풍', '벚꽃', '고즈넉', '전통', '가이세키', '아시아'],
